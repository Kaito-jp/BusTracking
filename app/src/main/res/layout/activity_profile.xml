<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProfileActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_title"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lightning"
            app:tint="@color/gray_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Profile Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_user_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_fab"
                        android:contentDescription="@null"
                        android:padding="4dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/user_name"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/userEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_email"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/verifiedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/verified"
                        android:textColor="@color/gray_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/editProfileLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/edit_profile"
                    android:textColor="@color/blue_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Community Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#F0F7FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@color/blue_bg_light"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/blue_primary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/help_community_title"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/help_community_desc"
                            android:textColor="@color/gray_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnReport"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:backgroundTint="@color/blue_primary"
                        android:text="@string/btn_report"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Settings Sections -->
            <!-- Notifications -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_notifications" />

            <RelativeLayout style="@style/SettingItem">
                <ImageView
                    android:id="@+id/iconNotif"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_notifications" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconNotif"
                    android:text="@string/push_notifications" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:checked="true" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnArrivalRadius"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconRadius"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_track_bus_btn" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconRadius"
                    android:text="@string/arrival_radius" />
                <TextView
                    style="@style/SettingValue"
                    android:text="@string/radius_value" />
            </RelativeLayout>

            <!-- Preferences -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_preferences" />

            <RelativeLayout
                android:id="@+id/btnLanguage"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconLang"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_language" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconLang"
                    android:text="@string/language" />
                <TextView
                    style="@style/SettingValue"
                    android:text="@string/lang_value" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnDistanceUnits"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconDist"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_target"
                    app:tint="@color/gray_text" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconDist"
                    android:text="@string/distance_units" />
                <TextView
                    style="@style/SettingValue"
                    android:text="@string/units_value" />
            </RelativeLayout>

            <!-- Privacy -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_privacy" />

            <RelativeLayout
                android:id="@+id/btnLocationPrivacy"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconPriv"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/gray_text" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconPriv"
                    android:text="@string/location_privacy" />
                <TextView
                    style="@style/SettingValue"
                    android:text="@string/location_value" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnLinkedAccounts"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconAccount"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_people" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconAccount"
                    android:text="@string/linked_accounts" />
                <TextView
                    style="@style/SettingValue"
                    android:text="@string/accounts_value" />
            </RelativeLayout>

            <!-- App Support -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_support" />

            <RelativeLayout
                android:id="@+id/btnHelpCenter"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconHelp"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_help" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconHelp"
                    android:text="@string/help_center" />
                <ImageView
                    style="@style/SettingArrow"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnInviteFriends"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconInvite"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_people" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconInvite"
                    android:text="@string/invite_friends" />
                <ImageView
                    style="@style/SettingArrow"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

            <RelativeLayout style="@style/SettingItem">
                <ImageView
                    android:id="@+id/iconVer"
                    style="@style/SettingIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/gray_text" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconVer"
                    android:text="@string/version" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/version_value"
                    android:textColor="@color/gray_text"
                    android:textSize="10sp" />
            </RelativeLayout>

            <!-- Account Actions -->
            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_account" />

            <RelativeLayout
                android:id="@+id/btnDeleteData"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconDeleteData"
                    style="@style/SettingIcon"
                    android:background="@color/red_bg_light"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/red_error" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconDeleteData"
                    android:text="@string/delete_data"
                    android:textColor="@color/red_error" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnSignOut"
                style="@style/SettingItem"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iconLogout"
                    style="@style/SettingIcon"
                    android:background="@color/red_bg_light"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_logout" />
                <TextView
                    style="@style/SettingLabel"
                    android:layout_toEndOf="@id/iconLogout"
                    android:text="@string/sign_out"
                    android:textColor="@color/red_error" />
            </RelativeLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/made_in_ph"
                android:textColor="@color/gray_border"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home_nav"
                app:tint="@color/gray_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="@color/gray_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTrack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_track_bus_btn"
                app:tint="@color/gray_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_track"
                android:textColor="@color/gray_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTerminals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_grid"
                app:tint="@color/gray_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_terminals"
                android:textColor="@color/gray_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_nav"
                app:tint="@color/blue_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="@color/blue_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>