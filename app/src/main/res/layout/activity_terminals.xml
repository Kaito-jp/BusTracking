<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".TerminalsActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:text="@string/terminals_title"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:drawableEndCompat="@drawable/ic_search"
        app:drawableTint="@color/black"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Search Bar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/gray_bg_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search" />
                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:hint="@string/search_terminals_hint"
                        android:inputType="text"
                        android:textSize="14sp" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_filter" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Categories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_blue_button"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/chip_all"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/chipNearMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/chip_near"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/chipFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/chip_fav"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/chip_247"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Hubs Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <TextView
                    android:id="@+id/hubsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnViewOnMap"
                    android:text="@string/transit_hubs"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/hubsTitle"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnViewOnMap"
                    android:text="@string/found_results"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/btnViewOnMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/view_on_map"
                    android:textColor="@color/blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Terminals List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- PITX -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPITX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/name1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/starIcon1"
                                android:text="@string/pitx_name"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/name1"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="2dp"
                                android:layout_toStartOf="@id/starIcon1"
                                app:drawableStartCompat="@drawable/ic_track_bus_btn"
                                android:drawablePadding="4dp"
                                app:drawableTint="@color/gray_text"
                                android:text="@string/pitx_addr"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />
                            <ImageView
                                android:id="@+id/starIcon1"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star"
                                app:tint="@color/gray_border" />
                        </RelativeLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_launcher_background" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_white_button"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="@string/dist_4_2km"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:divider="?android:attr/dividerVertical"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:showDividers="middle">
                            <TextView
                                android:id="@+id/btnFullSchedulePITX"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                app:drawableStartCompat="@drawable/ic_calendar"
                                android:drawablePadding="8dp"
                                android:padding="8dp"
                                android:text="@string/btn_full_schedule"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackground" />
                            <TextView
                                android:id="@+id/btnGetInfoPITX"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                app:drawableStartCompat="@drawable/ic_send"
                                android:drawablePadding="8dp"
                                android:padding="8dp"
                                android:text="@string/btn_get_info"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackground" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cubao -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCubao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/name2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/starIcon2"
                                android:text="@string/cubao_name"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/name2"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="2dp"
                                android:layout_toStartOf="@id/starIcon2"
                                app:drawableStartCompat="@drawable/ic_track_bus_btn"
                                android:drawablePadding="4dp"
                                app:drawableTint="@color/gray_text"
                                android:text="@string/cubao_addr"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />
                            <ImageView
                                android:id="@+id/starIcon2"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star"
                                app:tint="@color/gray_border" />
                        </RelativeLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_launcher_background" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_white_button"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="@string/dist_8_5km"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:divider="?android:attr/dividerVertical"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:showDividers="middle">
                            <TextView
                                android:id="@+id/btnFullScheduleCubao"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                app:drawableStartCompat="@drawable/ic_calendar"
                                android:drawablePadding="8dp"
                                android:padding="8dp"
                                android:text="@string/btn_full_schedule"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackground" />
                            <TextView
                                android:id="@+id/btnGetInfoCubao"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                app:drawableStartCompat="@drawable/ic_send"
                                android:drawablePadding="8dp"
                                android:padding="8dp"
                                android:text="@string/btn_get_info"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackground" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Footer text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="32dp"
                    android:gravity="center"
                    android:text="@string/footer_terminals"
                    android:textColor="@color/gray_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_home_nav"
            app:drawableTint="@color/gray_text" />

        <TextView
            android:id="@+id/navTrack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_track"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_bus"
            app:drawableTint="@color/gray_text" />

        <TextView
            android:id="@+id/navTerminals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_terminals"
            android:textColor="@color/blue_primary"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_track_bus_btn"
            app:drawableTint="@color/blue_primary" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_profile"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_profile_nav" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
